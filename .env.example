# ======================================================
# DATABASE (MSSQL)
# ======================================================
# SQL Server host and port configuration
DB_SERVER=localhost,1433

# Target database name used by the application
DB_NAME=HotelReservationDb

# Database authentication username
DB_USER=sa

# Database authentication password
DB_PASSWORD=YourStrong!Passw0rd

# Full connection string consumed by the API layer
# Includes trust for server certificate (useful for local/dev environments)
DB_CONNECTION=Server=localhost,1433;Database=HotelReservationDb;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;


# ======================================================
# REDIS
# ======================================================
# Redis connection string used for distributed locking and caching
REDIS_CONNECTION=localhost:6379


# ======================================================
# KAFKA
# ======================================================
# Feature toggle to enable/disable Kafka integration
KAFKA_ENABLED=true

# Kafka broker address
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Primary topic for reservation events
KAFKA_TOPIC=reservation-events

# Dead-letter queue topic for failed events
KAFKA_DLQ_TOPIC=reservation-events-dlq


# ======================================================
# ASP.NET CORE
# ======================================================
# Application environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development

# Application listening URL and port
ASPNETCORE_URLS=http://localhost:5283


# ======================================================
# LOGGING (SERILOG)
# ======================================================
# Minimum log level for application logs
SERILOG_MIN_LEVEL=Information