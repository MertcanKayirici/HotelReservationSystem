@{
    ViewData["Title"] = "Rezervasyon";
}

<div class="container mt-5" style="max-width: 800px;">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <h2 class="fw-bold mb-2">Rezervasyon Oluştur</h2>
            <p class="text-muted mb-4">
                Oda ve kullanıcı bilgilerini girerek rezervasyon oluştur.
            </p>


@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

            <form method="post" action="/Reservations">
                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Oda ID</label>
                        <input
                            name="RoomId"
                            type="number"
                            class="form-control"
                            placeholder="Örn: 1"
                            required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Kullanıcı ID</label>
                        <input
                            name="UserId"
                            type="number"
                            class="form-control"
                            placeholder="Örn: 1"
                            required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Giriş Tarihi</label>
                        <input
                            name="CheckIn"
                            type="datetime-local"
                            class="form-control"
                            required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Çıkış Tarihi</label>
                        <input
                            name="CheckOut"
                            type="datetime-local"
                            class="form-control"
                            required />
                    </div>

                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        Rezervasyon Oluştur
                    </button>

                    <a href="/Rooms" class="btn btn-outline-secondary">
                        Odalara Dön
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>