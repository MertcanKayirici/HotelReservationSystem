@model List<HotelReservationSystem.Application.DTOs.RoomDto>

@{
    ViewData["Title"] = "Odalar";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Oda Yönetimi</h2>
            <p class="text-muted mb-0">Sistemdeki odaları görüntüle ve yönet</p>
        </div>

        <a href="/Rooms/Create" class="btn btn-primary px-4">
            + Yeni Oda
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Oda Adı</th>
                            <th>Fiyat</th>
                            <th>Kapasite</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var room in Model)
                            {
                                <tr>
                                    <td>#@room.Id</td>
                                    <td class="fw-semibold">@room.Name</td>
                                    <td>@room.Price.ToString("N0") ₺</td>
                                    <td>@room.Capacity Kişi</td>
                                    <td>
                                        @if (room.IsActive)
                                        {
                                            <span class="badge bg-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Pasif</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a href="/Rooms/Edit/@room.Id" class="btn btn-sm btn-warning me-2">
                                            Düzenle
                                        </a>

                                        <a href="/Rooms/Delete/@room.Id" class="btn btn-sm btn-danger">
                                            Sil
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    Kayıtlı oda bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>