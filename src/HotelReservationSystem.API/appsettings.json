{
  // Database connection configuration used by the application
  "ConnectionStrings": {
    // Primary SQL Server connection string for the Hotel database
    "DefaultConnection": "Server=.;Database=HotelReservationDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },




  // Application logging configuration
  "Logging": {
    "LogLevel": {
      // Default log level for application logs
      "Default": "Information",

      // Reduced verbosity for ASP.NET Core internal logs
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Defines which hosts are allowed to access the application
  "AllowedHosts": "*",



  // Kafka messaging configuration for event-driven communication
  "Kafka": {
    // Enables or disables Kafka integration
    "Enabled": false,

    // Kafka broker address(es)
    "BootstrapServers": "localhost:9092",

    // Primary topic for reservation-related events
    "Topic": "reservation-events",

    // Dead-letter queue topic for failed message processing
    "DlqTopic": "reservation-events-dlq"
  },



  // Redis configuration for caching and distributed state management
  "Redis": {
    // Enables or disables Redis integration
    "Enabled": false,

    // Redis connection endpoint
    "Connection": "localhost:6379"
  }
}